    {
      "name": "Line Map (hero)",
      "kind": "nav",
      "refersTo": "panel",
      "description": "Signature: green track, white stations with ink rings, one transfer, one selected.",
      "html": "<nav class=\"ds-line\"><div class=\"ds-track\"></div><ol><li><span class=\"ds-dot\"></span><span class=\"ds-name\">아이스브레이킹</span></li><li class=\"sel\"><span class=\"ds-dot\"></span><span class=\"ds-name\">이력서 검증</span></li><li><span class=\"ds-dot ds-transfer\"></span><span class=\"ds-name\">꼬리질문</span></li><li><span class=\"ds-dot\"></span><span class=\"ds-name\">마무리</span></li></ol></nav>",
      "css": ".ds-line{position:relative;font-family:'Pretendard Variable',Pretendard,sans-serif;color:#141414;--dot:26px;--track:12px}.ds-track{position:absolute;left:12.5%;right:12.5%;top:calc(var(--dot)/2 - var(--track)/2);height:var(--track);background:#00a84d;border-radius:12px}.ds-line ol{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);position:relative}.ds-line li{display:flex;flex-direction:column;align-items:center;gap:.55rem;text-align:center}.ds-dot{width:var(--dot);height:var(--dot);border-radius:50%;background:#fff;border:4px solid #141414;box-sizing:border-box;transition:transform 220ms cubic-bezier(.16,1,.3,1)}.ds-transfer{border-width:5px;outline:3px solid #141414;outline-offset:3px}.ds-line li:hover .ds-dot{transform:scale(1.15)}.ds-line li.sel .ds-dot{background:#141414;transform:scale(1.25)}.ds-name{font-weight:800;font-size:1.0625rem;letter-spacing:-.02em}.ds-line li.sel .ds-name{color:#007a39}"
    },
    {
      "name": "Line Map (compact)",
      "kind": "nav",
      "refersTo": "panel",
      "description": "Room header progress: done stations Deep Green, current ink and enlarged.",
      "html": "<nav class=\"ds-line ds-compact\"><div class=\"ds-track\"></div><ol><li class=\"done\"><span class=\"ds-dot\"></span><span class=\"ds-name\">자기소개</span></li><li class=\"now\"><span class=\"ds-dot\"></span><span class=\"ds-name\">지원동기</span></li><li><span class=\"ds-dot\"></span><span class=\"ds-name\">이력서</span></li><li><span class=\"ds-dot\"></span><span class=\"ds-name\">마무리</span></li></ol></nav>",
      "css": ".ds-compact{position:relative;font-family:'Pretendard Variable',Pretendard,sans-serif;--dot:16px;--track:6px}.ds-compact .ds-track{position:absolute;left:12.5%;right:12.5%;top:calc(var(--dot)/2 - var(--track)/2);height:var(--track);background:#00a84d;border-radius:6px}.ds-compact ol{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);position:relative}.ds-compact li{display:flex;flex-direction:column;align-items:center;gap:.4rem}.ds-compact .ds-dot{width:16px;height:16px;border-radius:50%;background:#fff;border:3px solid #141414;box-sizing:border-box}.ds-compact .done .ds-dot{background:#007a39;border-color:#007a39}.ds-compact .now .ds-dot{background:#141414;transform:scale(1.35)}.ds-compact .ds-name{font-size:.72rem;font-weight:600;color:#4b4f4a}.ds-compact .now .ds-name{color:#141414;font-weight:800}"
