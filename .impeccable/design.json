  "narrative": {
    "northStar": "The Line Map",
    "overview": "The mock interview is drawn as one Seoul-metro line: twelve stations from icebreaking to closing, a follow-up question being a transfer. White ground, near-black ink, one committed Line 2 green track. Flat tonal panels, fully round buttons, no shadows, no gradients, no kickers.",
    "keyCharacteristics": [
      "One ground, one ink, one line colour; green is track, primary fill and small text only.",
      "Station language: white dot with 4px ink ring; transfer = double ring.",
      "Fully round, flat buttons.",
      "Tonal panels instead of elevated cards; no gradients.",
      "Authored SVG icons, 2px round stroke.",
      "Real product captures and a recorded 3D-room loop as the only imagery."
    ],
    "rules": [
      {
        "name": "The Graphic-vs-Text Green Rule",
        "body": "#00a84d is never used for text or a fill carrying text; use #007a39.",
        "section": "colors"
      },
      {
        "name": "The One Line Rule",
        "body": "One line colour only; no second line colour or green-tinted panels beyond Line Pale chips.",
        "section": "colors"
      },
      {
        "name": "The Highlighter Rule",
        "body": "Yellow marks evidence and sample/notice status only.",
        "section": "colors"
      },
      {
        "name": "The Heavy Name Rule",
        "body": "Station names and headings are 800 weight.",
        "section": "typography"
      },
      {
        "name": "The No Kicker Rule",
        "body": "No small uppercase or tracked label above a heading.",
        "section": "typography"
      },
      {
        "name": "The Tonal Step Rule",
        "body": "Raise a surface by changing its tone one step; never a shadow, blur or glow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use #007a39 for any green text or green fill that carries text; #00a84d only for track and graphics.",
      "Do build new layouts from the line: a track, stations, a spine.",
      "Do keep every button fully round and flat; separate surfaces by one tonal step.",
      "Do draw icons as authored SVG with a 2px round stroke.",
      "Do label sample or fictional data where it appears.",
      "Do turn the line vertical under 860px.",
      "Do honour prefers-reduced-motion; use only --ease-out."
    ],
    "donts": [
      "Don't use box-shadow, text-shadow, glow or any gradient.",
      "Don't add kickers, eyebrows, section numbers or small uppercase labels above headings.",
      "Don't structure content as three feature cards or bordered cards-as-structure.",
      "Don't use emoji, icon fonts or glyph characters as icons.",
      "Don't introduce a second line colour, a dark theme, or green-tinted panel fills.",
      "Don't set text in #00a84d or light-weight display type.",
      "Don't show prices, testimonials, logos, user counts or pass-rate claims.",
      "Don't use stock imagery or invented 3D renders; show the real room."
    ]
  }
