      "css": ".ds-label{display:block;font:700 .95rem 'Pretendard Variable',Pretendard,sans-serif;color:#141414}.ds-input{display:block;width:100%;margin-top:.4em;font:400 1.0625rem 'Pretendard Variable',Pretendard,sans-serif;border:2px solid #e6e8e3;border-radius:10px;padding:.65em .8em;background:#fff;color:#141414;transition:border-color 160ms cubic-bezier(.16,1,.3,1)}.ds-input:hover{border-color:#cfd3cc}.ds-input:focus{border-color:#007a39;outline:none}.ds-input::placeholder{color:#767a74}"
